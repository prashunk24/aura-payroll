{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "REDIS_HOST",
    "REDIS_PORT",
    "SOLANA_NETWORK",
    "SOLANA_RPC_URL",
    "AURA_PROGRAM_ID",
    "TAX_VAULT_PROGRAM_ID",
    "PORT",
    "VITE_API_BASE_URL",
    "VITE_SOLANA_NETWORK",
    "VITE_SOLANA_RPC"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
