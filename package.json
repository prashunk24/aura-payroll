{
  "name": "aura-payroll",
  "private": true,
  "packageManager": "npm@11.12.1",
  "scripts": {
    "build": "vite build --config apps/frontend/vite.config.ts apps/frontend",
    "build:dev": "vite build --mode development --config apps/frontend/vite.config.ts apps/frontend",
    "build:all": "turbo build",
    "dev": "vite --config apps/frontend/vite.config.ts apps/frontend",
    "dev:all": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "install-all": "npm install"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "programs/*"
  ],
  "devDependencies": {
    "playwright": "^1.60.0",
    "turbo": "latest"
  }
}
